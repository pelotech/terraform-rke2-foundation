# Defines imds_token for the callers of imds-token.sh: an access token for the resource in $1 from the service principal CLIENT_ID and CLIENT_SECRET.
CLIENT_SECRET='${client_secret}'
imds_token() {
  curl -sf -X POST "https://${login_host}/${tenant_id}/oauth2/token" \
    --data-urlencode "grant_type=client_credentials" --data-urlencode "client_id=$CLIENT_ID" \
    --data-urlencode "client_secret=$CLIENT_SECRET" --data-urlencode "resource=$1" \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["access_token"])'
}
