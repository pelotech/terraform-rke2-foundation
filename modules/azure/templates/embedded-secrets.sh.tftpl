#!/usr/bin/env bash
# Sourced by bootstrap.sh. fetch NAME PATH writes the secret cloud-init carried in this file to SECRET_DIR/PATH.
fetch() {
  local name="$1" out="$SECRET_DIR/$2"
  install -d -m 0700 "$(dirname "$out")"
  case "$name" in
%{ for name, content in secrets ~}
    ${name}) base64 -d > "$out.tmp" <<'SECRET'
${base64encode(content)}
SECRET
      ;;
%{ endfor ~}
    *) echo "embedded-secrets: no secret named $name" >&2; return 1 ;;
  esac
  chmod 0600 "$out.tmp"
  mv "$out.tmp" "$out"
}
