#!/usr/bin/env bash
# Sourced by bootstrap.sh. fetch NAME PATH reads a Key Vault secret with the VM's managed identity
# and writes it to SECRET_DIR/PATH.
VAULT_URI='${vault_uri}'
AUDIENCE='${audience}'
CLIENT_ID='${client_id}'
TOKEN=""

${imds_token}
fetch() {
  local name="$1" out="$SECRET_DIR/$2"
  install -d -m 0700 "$(dirname "$out")"
  # Role assignments take minutes to propagate, so keep trying; a failed read also refreshes the token.
  for _ in $(seq 1 90); do
    if [ -z "$TOKEN" ]; then
      TOKEN=$(imds_token "$AUDIENCE") || TOKEN=""
    fi
    if [ -n "$TOKEN" ] \
      && curl -sf -H "Authorization: Bearer $TOKEN" "$${VAULT_URI%/}/secrets/$name?api-version=7.4" \
        | python3 -c 'import json, sys; sys.stdout.write(json.load(sys.stdin)["value"])' > "$out.tmp"; then
      chmod 0600 "$out.tmp"
      mv "$out.tmp" "$out"
      return 0
    fi
    TOKEN=""
    sleep 10
  done
  echo "fetch-secrets: could not read $name from $VAULT_URI" >&2
  return 1
}
