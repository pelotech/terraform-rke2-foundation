# Local .terraform directories
**/.terraform/*

# Provider lock files. These are reusable modules, not root modules: pinning providers here would
# constrain every consumer. CI regenerates them via `terraform init` for `terraform test`.
.terraform.lock.hcl
**/.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json
# Shared inputs for terraform test.
!modules/*/tests/terraform.tfvars

# A kubeconfig written from the example output.
examples/*/kubeconfig
# Logs and plan files from live runs; a plan file holds every value, secrets included.
examples/*/*.log
examples/*/tfplan

# Generated by examples/local/run.sh.
examples/local/stage/*
!examples/local/stage/.gitkeep

# Iterative LLM-driven work
docs/superpowers

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

.idea/*

# direnv
.direnv
# envrc is special unlike other .env files, it's needed for direnv to work
!.envrc
.env

# nix
result
result-*
